<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.uniquindio.edu.proyecto_final_jfx.viewController.LoginViewController"
           style="-fx-background-color: #f5f5f5;"
           prefWidth="420" prefHeight="500">

    <VBox alignment="CENTER" spacing="14"
          maxWidth="360"
          style="-fx-background-color: #ffffff;
                 -fx-border-color: #e0e0e0;
                 -fx-border-radius: 12;
                 -fx-background-radius: 12;
                 -fx-padding: 40;">

        <Label text="EventosUQ"
               style="-fx-font-size: 22px; -fx-font-weight: bold;
                      -fx-text-fill: #111111; -fx-font-family: Arial;"/>

        <Label text="Ingresa tus credenciales"
               style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-font-family: Arial;"/>

        <Label text="Usuario (correo):"
               style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-font-family: Arial;"/>

        <TextField fx:id="txtUsuario"
                   promptText="correo@ejemplo.com"
                   maxWidth="Infinity"
                   style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-font-size: 13px; -fx-padding: 6 8 6 8;
                          -fx-text-fill: #111111; -fx-font-family: Arial;"/>

        <Label text="Contraseña:"
               style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-font-family: Arial;"/>

        <PasswordField fx:id="pfContrasena"
                       promptText="Contraseña"
                       maxWidth="Infinity"
                       style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-font-size: 13px; -fx-padding: 6 8 6 8;
                              -fx-text-fill: #111111; -fx-font-family: Arial;"/>

        <Label text="Rol:"
               style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-font-family: Arial;"/>

        <ComboBox fx:id="cbRol"
                  maxWidth="Infinity"
                  style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0;
                         -fx-border-radius: 6; -fx-background-radius: 6;
                         -fx-font-size: 13px; -fx-font-family: Arial;"/>

        <Button text="Ingresar"
                onAction="#onLogin"
                maxWidth="Infinity"
                style="-fx-background-color: #0F6E56; -fx-text-fill: #ffffff;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-padding: 6 14 6 14; -fx-cursor: hand;
                       -fx-font-family: Arial;"/>

        <Label fx:id="lblError" text=""
               style="-fx-text-fill: #A32D2D; -fx-font-size: 12px; -fx-font-family: Arial;"/>

        <Separator maxWidth="Infinity"/>

        <Label text="Cuentas de prueba:"
               style="-fx-font-size: 10px; -fx-font-weight: bold;
                      -fx-text-fill: #888888; -fx-font-family: Arial;"/>

        <Label text="Admin: admin@uq.edu / 1234 / ADMINISTRADOR"
               style="-fx-font-size: 10px; -fx-text-fill: #888888; -fx-font-family: Arial;"/>

        <Label text="Usuario: laura@uq.edu / 1234 / USUARIO"
               style="-fx-font-size: 10px; -fx-text-fill: #888888; -fx-font-family: Arial;"/>
    </VBox>
</StackPane>
