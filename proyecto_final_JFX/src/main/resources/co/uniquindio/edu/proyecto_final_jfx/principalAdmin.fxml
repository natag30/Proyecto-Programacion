<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.proyecto_final_jfx.viewController.PrincipalAdminViewController"
            prefWidth="950" prefHeight="620"
            style="-fx-background-color: #f5f5f5;">

    <!-- ── TOP ── -->
    <top>
        <HBox prefHeight="48" alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: transparent transparent #e0e0e0 transparent;
                     -fx-padding: 10 20 10 20;">
            <Label text="EventosUQ"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                          -fx-text-fill: #111111; -fx-font-family: Arial;"/>
            <Label text="ADMINISTRADOR"
                   style="-fx-background-color: #E1F5EE; -fx-text-fill: #085041;
                          -fx-background-radius: 4; -fx-font-size: 11px;
                          -fx-font-weight: bold; -fx-padding: 3 10 3 10;
                          -fx-font-family: Arial;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblBienvenida" text="Bienvenido"
                   style="-fx-font-size: 13px; -fx-text-fill: #555555;
                          -fx-font-family: Arial;"/>
            <Button text="Cerrar Sesion" onAction="#onCerrarSesion"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #A32D2D;
                           -fx-border-color: #e0e0e0; -fx-border-radius: 4;
                           -fx-background-radius: 4; -fx-font-size: 12px;
                           -fx-padding: 5 12 5 12; -fx-cursor: hand;
                           -fx-font-family: Arial;"/>
        </HBox>
    </top>

    <!-- ── LEFT SIDEBAR ── -->
    <left>
        <VBox prefWidth="160" spacing="2"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: transparent #e0e0e0 transparent transparent;
                     -fx-padding: 14 8 14 8;">
            <Label text="GESTION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #9ca3af; -fx-padding: 16 12 4 12;
                          -fx-background-color: transparent; -fx-font-family: Arial;"/>
            <Button fx:id="btnEventos" text="Eventos"
                    onAction="#onVerEventos" maxWidth="Infinity"
                    style="-fx-background-color: #E1F5EE; -fx-text-fill: #085041;
                           -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;
                           -fx-font-size: 13px; -fx-padding: 7 8 7 8;
                           -fx-background-radius: 6; -fx-cursor: hand;
                           -fx-font-family: Arial;"/>
            <Button fx:id="btnAgregarEvento" text="Agregar Evento"
                    onAction="#onAgregarEvento" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-alignment: CENTER_LEFT; -fx-font-size: 13px;
                           -fx-padding: 7 8 7 8; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-family: Arial;"/>
            <Button fx:id="btnUsuarios" text="Usuarios"
                    onAction="#onVerUsuarios" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-alignment: CENTER_LEFT; -fx-font-size: 13px;
                           -fx-padding: 7 8 7 8; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-family: Arial;"/>
            <Button fx:id="btnCompras" text="Compras"
                    onAction="#onVerCompras" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-alignment: CENTER_LEFT; -fx-font-size: 13px;
                           -fx-padding: 7 8 7 8; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-family: Arial;"/>
            <Button fx:id="btnIncidencias" text="Incidencias"
                    onAction="#onVerIncidencias" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-alignment: CENTER_LEFT; -fx-font-size: 13px;
                           -fx-padding: 7 8 7 8; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-family: Arial;"/>
            <Label text="ANALISIS"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #9ca3af; -fx-padding: 16 12 4 12;
                          -fx-background-color: transparent; -fx-font-family: Arial;"/>
            <Button fx:id="btnMetricas" text="Metricas"
                    onAction="#onVerMetricas" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-alignment: CENTER_LEFT; -fx-font-size: 13px;
                           -fx-padding: 7 8 7 8; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-family: Arial;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar Sesion" onAction="#onCerrarSesion"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #A32D2D;
                           -fx-alignment: CENTER_LEFT; -fx-font-size: 13px;
                           -fx-padding: 7 8 7 8; -fx-background-radius: 6;
                           -fx-cursor: hand; -fx-font-family: Arial;"/>
        </VBox>
    </left>

    <!-- ── CENTER ── -->
    <center>
        <AnchorPane fx:id="contenidoCentral"
                    style="-fx-background-color: #f5f5f5;"/>
    </center>
</BorderPane>
